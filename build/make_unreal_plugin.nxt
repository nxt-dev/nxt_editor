{
    "version": "1.17",
    "alias": "make_unreal_plugin",
    "color": "#879fda",
    "mute": false,
    "solo": false,
    "meta_data": {
        "positions": {
            "/make_plugin": [
                -144.0,
                -49.0
            ]
        }
    },
    "nodes": {
        "/": {
            "code": [
                "import os",
                "import shutil"
            ]
        },
        "/make_plugin": {
            "start_point": true,
            "attrs": {
                "icon_path": {
                    "type": "raw",
                    "value": "${file::../nxt_editor/resources/icons/nxt_128.png}"
                },
                "result_dir": {
                    "type": "raw",
                    "value": "${path::nxt_unreal}"
                },
                "unreal_integration_dir": {
                    "type": "raw",
                    "value": "${file::../nxt_editor/integration/unreal}"
                },
                "uplugin_path": {
                    "type": "raw",
                    "value": "${file::${unreal_integration_dir}/nxt_unreal.uplugin}"
                },
                "editor_dir": {
                    "type": "raw",
                    "value": "${path::../nxt_editor}"
                },
                "core_dir": {
                    "type": "raw",
                    "value": "${path::../../nxt/nxt}"
                },
                "qt_py": {
                    "type": "raw",
                    "value": "${path::vendor/Qt.py}"
                }
            },
            "code": [
                "if os.path.exists('${result_dir}'):",
                "    shutil.rmtree('${result_dir}')",
                "junk = shutil.ignore_patterns('__pycache__', '.mypy_cache', '.pytest_cache', '*.pyc', 'qresources.py*')",
                "shutil.copytree('${unreal_integration_dir}', '${result_dir}', ignore=junk)",
                "resources_dir = '${result_dir}/Resources'",
                "os.makedirs(resources_dir)",
                "target_icon_path = os.path.join(resources_dir, 'Icon128.png')",
                "shutil.copyfile('${icon_path}', target_icon_path)",
                "# Unreal puts Content/Python on sys.path, so what the plugin runs goes",
                "# there. It used to carry none of it and pip install nxt-editor from PyPI",
                "# into the engine instead, which fetched whatever PyPI had rather than",
                "# this build, and needed the internet and write access to the engine.",
                "python_dir = os.path.join('${result_dir}', 'Content', 'Python')",
                "shutil.copytree('${editor_dir}', os.path.join(python_dir, 'nxt_editor'), ignore=junk)",
                "shutil.copytree('${core_dir}', os.path.join(python_dir, 'nxt'), ignore=junk)",
                "os.makedirs(os.path.join(python_dir, 'Qt'))",
                "shutil.copyfile('${qt_py}', os.path.join(python_dir, 'Qt', '__init__.py'))"
            ]
        }
    }
}