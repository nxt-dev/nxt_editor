{
    "version": "1.17",
    "alias": "make_maya_plugin",
    "color": "#0052aa",
    "mute": false,
    "solo": false,
    "references": [
        "../../nxt/build/GitUtils.nxt"
    ],
    "meta_data": {
        "positions": {
            "/": [
                0.0,
                0.0,
                0.0
            ],
            "/clone_fresh_source": [
                540.0,
                80.0
            ],
            "/make_module_folder": [
                560.0,
                -220.0
            ],
            "/zip_maya_plugin": [
                -142.0,
                -162.0
            ]
        }
    },
    "nodes": {
        "/": {
            "attrs": {
                "mod_folder": {
                    "type": "raw",
                    "value": "${output_dir}/nxt_maya"
                },
                "nxt_root": {
                    "type": "raw",
                    "value": "${path::..}"
                },
                "output_dir": {
                    "type": "raw",
                    "value": "${nxt_root}/build"
                },
                "src": {
                    "type": "raw",
                    "value": "remote"
                },
                "src_clone": {
                    "type": "raw",
                    "value": "${path::nxt-src}"
                }
            },
            "code": [
                "import os",
                "import shutil",
                "import sys",
                "import subprocess"
            ]
        },
        "/clone_fresh_source": {
            "instance": "/GitClone",
            "attrs": {
                "cmd_args": {
                    "type": "str",
                    "value": "\"clone\", \"git@github.com:nxt-dev/nxt.git\", \"${dir}\""
                },
                "dir": {
                    "type": "raw",
                    "value": "${src_clone}"
                }
            }
        },
        "/make_module_folder": {
            "start_point": true,
            "child_order": [
                "copy_source",
                "qt_py",
                "make_resources",
                "populate_mod_template",
                "clean_up"
            ],
            "code": [
                "if os.path.isdir('${mod_folder}'):",
                "    shutil.rmtree('${mod_folder}')",
                "    print('removed old build')",
                "template_mod = os.path.join('${nxt_root}', 'nxt_editor/integration', 'maya')",
                "shutil.copytree(template_mod, '${mod_folder}')"
            ]
        },
        "/make_module_folder/clean_up": {
            "code": [
                "# Whatever a local checkout picked up that has no business shipping.",
                "# A build on a build machine never has these; a build on a working",
                "# machine does, and they went straight into the module.",
                "junk = ('__pycache__', '.mypy_cache', '.pytest_cache')",
                "removed = 0",
                "for root, dirs, files in os.walk('${mod_folder}'):",
                "    for name in list(dirs):",
                "        if name in junk:",
                "            shutil.rmtree(os.path.join(root, name), ignore_errors=True)",
                "            dirs.remove(name)",
                "            removed += 1",
                "print('removed {} cache folder(s) from the module'.format(removed))",
                "",
                "# The clone only exists when building from a fetched source. This",
                "# checked a path on somebody's D: drive, so it never ran anywhere else.",
                "if os.path.isdir('${src_clone}'):",
                "    try:",
                "        shutil.rmtree('${src_clone}')",
                "    except Exception:",
                "        print('!' * 79)",
                "        print('Failed to delete source clone, do so by hand!')",
                "        print(' ' * 3 + '${src_clone}')"
            ]
        },
        "/make_module_folder/copy_source": {
            "attrs": {
                "clone_node": {
                    "type": "raw",
                    "value": "/clone_fresh_source"
                },
                "core_script_src": {
                    "type": "raw",
                    "value": "${mod_folder}/scripts/nxt"
                },
                "editor_script_src": {
                    "type": "raw",
                    "value": "${mod_folder}/scripts/nxt_editor"
                }
            },
            "code": [
                "shutil.copytree('${path::${nxt_root}/nxt_editor}', '${editor_script_src}')",
                "",
                "# Get core code",
                "if '${src}' == 'local':",
                "    shutil.copytree('${path::${nxt_root}/../nxt/nxt}', '${core_script_src}')",
                "else:",
                "    if os.path.isdir('${src_clone}'):",
                "        shutil.rmtree('${src_clone}')",
                "    execute(start='${clone_node}')",
                "    shutil.copytree('${path::${src_clone}/nxt}', '${core_script_src}')"
            ]
        },
        "/make_module_folder/make_resources": {
            "code": [
                "import subprocess",
                "# The editor's resources are generated, not committed. This used to",
                "# reach for a ui/ folder that no longer exists and call pyside2-rcc,",
                "# from before the move to PySide6, so it threw and took the rest of",
                "# the build with it: the .mod kept its <VERSION> placeholder and the",
                "# clean up step never ran.",
                "editor = '${../copy_source.editor_script_src}'",
                "qrc_path = os.path.join(editor, 'resources', 'resources.qrc')",
                "result_path = os.path.join(editor, 'qresources.py')",
                "for stale in (result_path, result_path + 'c'):",
                "    if os.path.isfile(stale):",
                "        os.remove(stale)",
                "        print('removed old {}'.format(stale))",
                "print('generating nxt resources from {} to {}'.format(qrc_path,",
                "                                                      result_path))",
                "try:",
                "    subprocess.check_call(['pyside6-rcc', qrc_path, '-o', result_path,",
                "                           '-g', 'python'])",
                "except Exception as error:",
                "    # nxt_editor builds these itself on first import when they are",
                "    # missing or older than the qrc, so a machine without rcc still",
                "    # ends up with them. Worth saying, not worth failing the package.",
                "    print('could not build resources here ({}); nxt_editor will build '",
                "          'them on first import'.format(error))"
            ]
        },
        "/make_module_folder/populate_mod_template": {
            "attrs": {
                "mod_file": {
                    "type": "raw",
                    "value": "${mod_folder}/nxt.mod"
                }
            },
            "code": [
                "from nxt_editor.integration import plugin_version",
                "with open('${mod_file}', 'r') as fp:",
                "    content = fp.read()",
                "content = content.replace('<VERSION>', plugin_version())",
                "with open('${mod_file}', 'w') as fp:",
                "    fp.write(content)"
            ]
        },
        "/make_module_folder/qt_py": {
            "code": [
                "import hashlib",
                "try:",
                "    from urllib.request import urlopen",
                "except ImportError:",
                "    from urllib2 import urlopen",
                "",
                "# Qt.py belongs to somebody else and only matters when a host package",
                "# is being built, so it is fetched here rather than kept in this repo.",
                "#",
                "# Pinned, and checked. It used to be fetched from master, which now",
                "# 404s because the branch was renamed, and it was fetched with a call",
                "# that does not raise on 404: the module shipped in the Maya package",
                "# was fourteen bytes reading '404: Not Found', and nothing said so",
                "# until somebody tried to import Qt.",
                "#",
                "# 1.4.8 is what nxt_editor is developed and tested against. The latest",
                "# release is 2.x and is not the same library; moving to it is a change",
                "# to make deliberately, not one to inherit from whatever master is on",
                "# the day a package gets built.",
                "QT_PY_VERSION = '1.4.8'",
                "QT_PY_SHA256 = ('83b362991053fd794fc9d16c06d769e3'",
                "                'd0c409fbc15b3df291aadae72887be35')",
                "url = ('https://raw.githubusercontent.com/mottosso/Qt.py/'",
                "       '{}/Qt.py'.format(QT_PY_VERSION))",
                "",
                "print('fetching Qt.py {} from {}'.format(QT_PY_VERSION, url))",
                "content = urlopen(url, timeout=60).read()",
                "digest = hashlib.sha256(content).hexdigest()",
                "if digest != QT_PY_SHA256:",
                "    raise RuntimeError(",
                "        'Qt.py {} does not hash to what it did when this was pinned. '",
                "        'Expected {}, got {}. Refusing to package something other '",
                "        'than what was asked for.'",
                "        .format(QT_PY_VERSION, QT_PY_SHA256, digest))",
                "print('Qt.py {} verified, {} bytes'.format(QT_PY_VERSION, len(content)))",
                "",
                "# Shaped as a package rather than a module so it does not turn up in",
                "# the host's plugin list.",
                "qt_dir = '${mod_folder}/scripts/Qt'",
                "if not os.path.isdir(qt_dir):",
                "    os.makedirs(qt_dir)",
                "with open(os.path.join(qt_dir, '__init__.py'), 'wb') as fp:",
                "    fp.write(content)"
            ]
        }
    }
}
