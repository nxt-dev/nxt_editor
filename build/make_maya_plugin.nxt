{
    "version": "1.17",
    "alias": "make_maya_plugin",
    "color": "#0052aa",
    "mute": false,
    "solo": false,
    "references": [
        "../../nxt/build/GitUtils.nxt"
    ],
    "meta_data": {
        "positions": {
            "/": [
                0.0,
                0.0,
                0.0
            ],
            "/clone_fresh_source": [
                540.0,
                80.0
            ],
            "/make_module_folder": [
                560.0,
                -220.0
            ],
            "/zip_maya_plugin": [
                -142.0,
                -162.0
            ]
        }
    },
    "nodes": {
        "/": {
            "attrs": {
                "mod_folder": {
                    "type": "raw",
                    "value": "${output_dir}/nxt_maya"
                },
                "nxt_root": {
                    "type": "raw",
                    "value": "${path::..}"
                },
                "output_dir": {
                    "type": "raw",
                    "value": "${nxt_root}/build"
                },
                "src": {
                    "type": "raw",
                    "value": "remote"
                },
                "src_clone": {
                    "type": "raw",
                    "value": "${path::nxt-src}"
                }
            },
            "code": [
                "import os",
                "import shutil",
                "import sys",
                "import subprocess"
            ]
        },
        "/clone_fresh_source": {
            "instance": "/GitClone",
            "attrs": {
                "cmd_args": {
                    "type": "str",
                    "value": "\"clone\", \"git@github.com:nxt-dev/nxt.git\", \"${dir}\""
                },
                "dir": {
                    "type": "raw",
                    "value": "${src_clone}"
                }
            }
        },
        "/make_module_folder": {
            "start_point": true,
            "child_order": [
                "copy_source",
                "qt_py",
                "make_resources",
                "populate_mod_template",
                "clean_up"
            ],
            "code": [
                "if os.path.isdir('${mod_folder}'):",
                "    shutil.rmtree('${mod_folder}')",
                "    print('removed old build')",
                "template_mod = os.path.join('${nxt_root}', 'nxt_editor/integration', 'maya')",
                "shutil.copytree(template_mod, '${mod_folder}')"
            ]
        },
        "/make_module_folder/clean_up": {
            "code": [
                "# Whatever a local checkout picked up that has no business shipping.",
                "# A build on a build machine never has these; a build on a working",
                "# machine does, and they went straight into the module.",
                "junk = ('__pycache__', '.mypy_cache', '.pytest_cache')",
                "removed = 0",
                "for root, dirs, files in os.walk('${mod_folder}'):",
                "    for name in list(dirs):",
                "        if name in junk:",
                "            shutil.rmtree(os.path.join(root, name), ignore_errors=True)",
                "            dirs.remove(name)",
                "            removed += 1",
                "print('removed {} cache folder(s) from the module'.format(removed))",
                "",
                "# The clone only exists when building from a fetched source. This",
                "# checked a path on somebody's D: drive, so it never ran anywhere else.",
                "if os.path.isdir('${src_clone}'):",
                "    try:",
                "        shutil.rmtree('${src_clone}')",
                "    except Exception:",
                "        print('!' * 79)",
                "        print('Failed to delete source clone, do so by hand!')",
                "        print(' ' * 3 + '${src_clone}')"
            ]
        },
        "/make_module_folder/copy_source": {
            "attrs": {
                "clone_node": {
                    "type": "raw",
                    "value": "/clone_fresh_source"
                },
                "core_script_src": {
                    "type": "raw",
                    "value": "${mod_folder}/scripts/nxt"
                },
                "editor_script_src": {
                    "type": "raw",
                    "value": "${mod_folder}/scripts/nxt_editor"
                }
            },
            "code": [
                "shutil.copytree('${path::${nxt_root}/nxt_editor}', '${editor_script_src}')",
                "",
                "# Get core code",
                "if '${src}' == 'local':",
                "    shutil.copytree('${path::${nxt_root}/../nxt/nxt}', '${core_script_src}')",
                "else:",
                "    if os.path.isdir('${src_clone}'):",
                "        shutil.rmtree('${src_clone}')",
                "    execute(start='${clone_node}')",
                "    shutil.copytree('${path::${src_clone}/nxt}', '${core_script_src}')"
            ]
        },
        "/make_module_folder/make_resources": {
            "code": [
                "# Nothing to do. Left in place rather than deleted so the execution order",
                "# around it is untouched.",
                "#",
                "# This regenerated ui/resources.py from a .qrc with pyside2-rcc. Both ends",
                "# of that are gone: the resources are compiled into the committed",
                "# qresources.py now, nothing imports ui.resources, and the attribute it",
                "# read - copy_source.source_folder - does not exist on that node, so the",
                "# path resolved to '/ui/resources/resources.qrc' and the step failed on",
                "# every build. It also made pyside2-rcc a build dependency for a file the",
                "# module does not contain.",
                "print('resources are compiled into qresources.py; nothing to generate')"
            ]
        },
        "/make_module_folder/populate_mod_template": {
            "attrs": {
                "mod_file": {
                    "type": "raw",
                    "value": "${mod_folder}/nxt.mod"
                }
            },
            "code": [
                "import json",
                "",
                "# Read from the file rather than by importing nxt_editor. This graph",
                "# can run where nxt is but Qt is not, and nxt_editor",
                "# imports Qt the moment it is touched, so the import threw and took",
                "# the rest of the build with it: the .mod kept its <VERSION>",
                "# placeholder and the steps after this never ran.",
                "version_file = '${../copy_source.editor_script_src}/version.json'",
                "with open(version_file, 'r') as fp:",
                "    editor = json.load(fp)['EDITOR']",
                "version = '{MAJOR}.{MINOR}.{PATCH}'.format(**editor)",
                "",
                "with open('${mod_file}', 'r') as fp:",
                "    content = fp.read()",
                "content = content.replace('<VERSION>', version)",
                "with open('${mod_file}', 'w') as fp:",
                "    fp.write(content)",
                "print('nxt.mod version set to {}'.format(version))"
            ]
        },
        "/make_module_folder/qt_py": {
            "code": [
                "# Qt.py, shipped with the module rather than fetched while building it.",
                "#",
                "# This used to download it from mottosso/Qt.py@master. That branch no",
                "# longer exists, so the request answered 404 and the fourteen bytes",
                "# '404: Not Found' were written out as Qt/__init__.py - a SyntaxError the",
                "# moment anything imports Qt, which took the host's other tools down with",
                "# it rather than failing on its own.",
                "#",
                "# A build should not depend on somebody else's default branch name. The",
                "# copy in build/vendor is a released version and is what ships.",
                "#",
                "# Shaped as a package rather than a module so it stays out of Maya's",
                "# plugin list, which is what the original was doing too.",
                "import shutil",
                "",
                "source = '${path::vendor/Qt.py}'",
                "target = '${mod_folder}/scripts/Qt/__init__.py'",
                "",
                "os.makedirs(os.path.dirname(target), exist_ok=True)",
                "shutil.copyfile(source, target)",
                "",
                "# Cheap, and it is exactly the check whose absence shipped a broken",
                "# package: whatever lands here has to at least be Python.",
                "import py_compile",
                "py_compile.compile(target, doraise=True)",
                "print('vendored Qt.py ({} bytes)'.format(os.path.getsize(target)))"
            ]
        }
    }
}
